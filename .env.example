# ==============================================================================
# VERTEX SAAS: MULTI-TENANT SCRCPY CLOUD DEVICE MANAGEMENT PLATFORM
# Environment Variables Configuration
# ==============================================================================

# Server & Network Configuration
PORT=4000
NODE_ENV=production
BACKEND_URL=https://api.vertex-devices.com
FRONTEND_URL=https://vertex-devices.com

# Cryptography & Token Secrets (Minimum 32 characters)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
ENCRYPTION_KEY=your_encryption_aes256_key_32_bytes_long_here!

# Supabase PostgreSQL & Auth Credentials
# (Obtain from your Supabase Project Settings -> API & Database)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_DB_CONNECTION_STRING=postgresql://postgres.your-project:your-password@aws-0-region.pooler.supabase.com:6543/postgres

# Cloudflare Zero-Trust & Tunnel Automation
# (Obtain from Cloudflare Dashboard -> My Profile -> API Tokens)
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_with_dns_and_tunnel_permissions
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_ZONE_ID=your_cloudflare_dns_zone_id
CLOUDFLARE_DOMAIN=vertex-devices.com
